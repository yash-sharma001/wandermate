# Copy to .env and fill in. `docker compose up --build` reads it automatically.
POSTGRES_PASSWORD=change_me
RABBITMQ_PASSWORD=change_me
HASURA_ADMIN_SECRET=change_me_admin_secret
# Signs user JWTs (auth service) and verifies them (auth webhook for Hasura); use a long random string
JWT_SECRET=change_me_to_a_long_random_string
GATEWAY_PORT=80

# Optional: email (Gmail app password) and Twilio (SMS/WhatsApp SOS + phone OTP)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_ID=
